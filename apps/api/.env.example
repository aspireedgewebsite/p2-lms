NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aspireedge:local_dev_password_change_me@localhost:5432/aspireedge_lms?schema=public
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Required only for initial platform admin seed:
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-random-password
SEED_ADMIN_NAME=Platform Administrator

# Server-only settings for registration email verification
RESEND_API_KEY=
EMAIL_FROM="Aspireedge <noreply@aspireedgegroup.com>"
EMAIL_OTP_SECRET=
# Optional localhost-only OTP delivery for one owned test account.
DEV_OTP_RECOVERY_EMAIL=
# Optional localhost-only manual send test. Leave disabled outside a test session.
ENABLE_DEV_EMAIL_TEST=false
RESEND_TEST_RECIPIENT=

# Server-side Razorpay configuration. Use test keys for local checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
